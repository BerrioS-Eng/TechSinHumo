---
/*
  /blog/[slug] — detalle del artículo. getStaticPaths genera una ruta por post
  publicado. render() devuelve el <Content /> compilado del Markdown/MDX.
*/
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/landing/Header.astro';
import Footer from '../../components/landing/Footer.astro';
import { readingMinutes } from '../../utils/reading-time';

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const posts = await getCollection('blog', ({ data }) => !isProd || data.draft === false);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
const mins = post.data.readingMinutes ?? readingMinutes(post.body);
---
<BaseLayout title={`${post.data.title} — TechSinHumo`} description={post.data.description}>
  <Header />
  <main>
    <article class="section">
      <div class="wrap article__wrap">
        {post.data.draft && (
          <div class="draft-banner">
            Borrador · solo visible en desarrollo. Pendiente de revisión humana antes de publicar.
          </div>
        )}
        <p class="t-eyebrow">{post.data.category}</p>
        <h1 class="article__title">{post.data.title}</h1>
        <p class="article__meta">
          {fmtDate(post.data.pubDate)} · {mins} min de lectura · {post.data.author}
        </p>
        <div class="prose">
          <Content />
        </div>
        <a href="/blog" class="article__back">‹ Volver al blog</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .article__wrap { max-width: 720px; }
  .draft-banner {
    background: var(--c-accent-soft); color: var(--c-accent); border-radius: 12px;
    padding: 12px 16px; font-size: 14px; margin-bottom: 28px; font-family: var(--font-mono);
  }
  .article__title { margin-top: 12px; font-size: clamp(30px, 5vw, 48px); line-height: 1.1; letter-spacing: -0.03em; }
  .article__meta { margin-top: 16px; font-size: 14px; color: var(--c-fg-muted); }

  .prose { margin-top: clamp(32px, 5vw, 48px); font-size: 18px; line-height: 1.7; color: var(--c-fg); }
  .prose :global(h2) { margin-top: 1.8em; margin-bottom: 0.5em; font-size: clamp(22px, 3vw, 28px); letter-spacing: -0.02em; }
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--c-accent); padding-left: 18px; margin: 1.5em 0;
    color: var(--c-fg-muted); font-style: italic;
  }
  .prose :global(a) { color: var(--c-accent); text-decoration: underline; text-underline-offset: 3px; }

  .article__back { display: inline-block; margin-top: 48px; color: var(--c-accent); font-size: 15px; }
</style>