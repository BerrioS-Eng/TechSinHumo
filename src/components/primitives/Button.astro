---
/*
  Button.astro — pill. variant: primary (negro) | secondary (gris) | ghost.
  Renderiza <a> si recibe href, si no <button>. El contenido va por slot.
  El acento NO vive aquí: para CTA de acento usa LinkArrow.astro.
*/
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'lg';
  block?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [key: string]: any;
}
const {
  variant = 'primary', size, block, href, type = 'button',
  disabled, class: className = '', ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, size && `btn--${size}`, block && 'btn--block', className]
  .filter(Boolean).join(' ');
const Tag = href ? 'a' : 'button';
---
<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  {...rest}
>
  <slot />
</Tag>
