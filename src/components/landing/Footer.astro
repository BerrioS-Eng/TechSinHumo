---
/*
  Footer.astro — marca + 3 columnas de enlaces + línea legal.
  Enlaces placeholders (#) hasta que existan las páginas de destino.
*/
const cols = [
  { h: 'Producto', items: ['Comparar fibra', 'Comparar móvil', 'Ofertas de la semana', 'Operadores'] },
  { h: 'Recursos', items: ['Sin Humo (blog)', 'Metodología', 'Preguntas frecuentes'] },
  { h: 'Compañía', items: ['Quiénes somos', 'Contacto', 'Aviso legal', 'Privacidad'] },
];
---
<footer class="ft">
  <div class="wrap ft__inner">
    <div class="ft__top">
      <div class="ft__brand">
        <span class="wordmark">TechSinHumo</span>
        <p>Comparador independiente de fibra y móvil en España. Sin humo, solo datos.</p>
      </div>
      {cols.map((c) => (
        <div class="ft__cols">
          <h4>{c.h}</h4>
          <ul>
            {c.items.map((it) => <li><a href="#blog">{it}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="ft__bottom">
      <span>© 2026 TechSinHumo. Precios orientativos, contrasta siempre con el operador.</span>
      <span>Madrid, España</span>
    </div>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--c-border); background: var(--c-bg); }
  .ft__inner { padding-block: 48px 40px; }
  .ft__top { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 40px; }
  .wordmark { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: -0.03em; color: var(--c-fg); }
  .ft__cols h4 { font-size: 13px; color: var(--c-fg-muted); font-weight: 500; margin-bottom: 14px; letter-spacing: -0.005em; }
  .ft__cols ul { display: flex; flex-direction: column; gap: 11px; }
  .ft__cols a { font-size: 14px; color: var(--c-fg); transition: color 0.2s var(--ease-apple); }
  .ft__cols a:hover { color: var(--c-fg-muted); }
  .ft__brand p { margin-top: 12px; font-size: 14px; color: var(--c-fg-muted); max-width: 30ch; }
  .ft__bottom { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--c-border); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--c-fg-muted); }

  @media (max-width: 820px) { .ft__top { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (max-width: 480px) { .ft__top { grid-template-columns: 1fr; } }
</style>
