---
/*
  Blog.astro — "Sin Humo". Tres posts con cover tipográfico (sin imágenes, sin sombra).
  Los enlaces son placeholders (#blog) hasta que exista el detalle de artículo.
*/
import LinkArrow from '../primitives/LinkArrow.astro';

const posts = [
  {
    cat: 'Permanencia',
    cover: 'ink',
    title: 'Cómo salir de tu permanencia sin pagar de más',
    desc: 'Lo que el operador no te cuenta cuando intentas portarte.',
    date: '24 may 2026',
    read: '6 min',
  },
  {
    cat: 'Análisis',
    cover: 'surface',
    title: 'Fibra simétrica: cuándo importa y cuándo es marketing',
    desc: '600 Mb o 1 Gb: qué necesitas de verdad en casa.',
    date: '17 may 2026',
    read: '5 min',
  },
  {
    cat: 'Guía',
    cover: 'accent',
    title: 'Operadores low cost: la letra pequeña que sí vale la pena',
    desc: 'Digi, Pepephone, Lowi. Dónde ahorras y dónde no.',
    date: '9 may 2026',
    read: '8 min',
  },
];
---
<section class="section section--surface" id="blog" aria-labelledby="blog-title">
  <div class="wrap">
    <div class="cmp__head reveal">
      <div>
        <p class="t-eyebrow">Sin Humo · el blog</p>
        <h2 id="blog-title" class="t-h2 cmp__title blog__title">Para decidir con la cabeza, no con la prisa</h2>
      </div>
      <LinkArrow href="#blog">Ver todo</LinkArrow>
    </div>
    <div class="blog__grid">
      {posts.map((p) => (
        <a href="#blog" class="post reveal">
          <div class={`post__cover post__cover--${p.cover}`}>
            <span class="post__cover-cat">{p.cat}</span>
          </div>
          <div class="post__meta">{p.date} · {p.read} de lectura</div>
          <h3 class="post__title">{p.title}</h3>
          <p class="post__desc">{p.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cmp__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(32px, 5vw, 56px); }
  .blog__title { margin-top: 12px; max-width: 16ch; }

  .blog__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 56px); margin-top: clamp(36px, 5vw, 64px); }
  .post { display: flex; flex-direction: column; }
  .post__cover {
    border-radius: var(--radius-image); aspect-ratio: 4 / 3; overflow: hidden;
    background: var(--c-surface); display: flex; align-items: flex-end; padding: 22px;
    transition: opacity 0.3s var(--ease-apple);
  }
  .post:hover .post__cover { opacity: 0.92; }
  .post__cover-cat { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--c-fg-muted); }
  .post__cover--ink { background: var(--c-fg); }
  .post__cover--ink .post__cover-cat { color: color-mix(in oklch, var(--c-bg) 70%, transparent); }
  .post__cover--accent { background: var(--c-accent-soft); }
  .post__cover--accent .post__cover-cat { color: var(--c-accent); }
  .post__cover--surface { background: color-mix(in oklch, var(--c-surface) 55%, var(--c-border)); }
  .post__meta { margin-top: 18px; font-size: 13px; color: var(--c-fg-muted); }
  .post__title { margin-top: 8px; font-size: clamp(20px, 2.2vw, 24px); line-height: 1.2; letter-spacing: -0.02em; }
  .post__desc { margin-top: 10px; font-size: 16px; color: var(--c-fg-muted); }

  @media (max-width: 820px) { .blog__grid { grid-template-columns: 1fr; gap: 40px; max-width: 480px; } }
</style>
